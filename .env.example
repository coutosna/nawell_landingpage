# --- Servidor NAWELL (auth server-side) ---
# Porta do servidor Express
PORT=8080

# Segredo para assinar o JWT de sessão. Use um valor longo e aleatório em produção.
JWT_SECRET=troque-por-um-segredo-forte

# Duração da sessão em horas (padrão 12)
SESSION_HOURS=12

# true em produção (HTTPS), false em desenvolvimento (HTTP)
COOKIE_SECURE=false

# Lista de usuários internos com senha em hash bcrypt.
# Gere o hash com: node server/hash-password.js "suaSenha"
# Formato JSON de array.
AUTH_USERS=[{"username":"admin","passwordHash":"$2a$12$EXEMPLO...COLOQUE_O_HASH_BRUTO_AQUI"}]
